@@ -413,26 +413,26 @@ static int ipu7_isys_fw_pin_cfg(struct ipu7_isys_video *av,
 	/* output pin crop */
 	output_pin->crop.line_top = 0;
 	output_pin->crop.line_bottom = 0;
-#ifdef IPU8_INSYS_NEW_ABI
-	output_pin->crop.column_left = 0;
