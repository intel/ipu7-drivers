From 5ee6fa80bd6e2cb6734abed5daa877c91517412d Mon Sep 17 00:00:00 2001
From: Khai Wen, Ng <khai.wen.ng@intel.com>
Date: Thu, 8 Oct 2026 17:22:10 +0800
Subject: [PATCH 32/32] staging: media: ipu7: Set CSI2 port count by hardware version

IPU7 has four CSI2 ports, while IPU7P5 and IPU8 have three. Pass the hardware
version to platform data initialization and select the port count accordingly.

Ported from 5ee6fa80bd6e2cb6734abed5daa877c91517412d.

Signed-off-by: Khai Wen, Ng <khai.wen.ng@intel.com>
---
 drivers/staging/media/ipu7/ipu7.c | 7 +++++--
 drivers/staging/media/ipu7/ipu7.h | 3 ++-
 2 files changed, 6 insertions(+), 4 deletions(-)

diff --git a/drivers/staging/media/ipu7/ipu7.c b/drivers/staging/media/ipu7/ipu7.c
--- a/drivers/staging/media/ipu7/ipu7.c
+++ b/drivers/staging/media/ipu7/ipu7.c
@@ -2108,7 +2108,8 @@ void ipu_internal_pdata_init(struct ipu_isys_internal_pdata *isys_ipdata,
-			     struct ipu_psys_internal_pdata *psys_ipdata)
+			     struct ipu_psys_internal_pdata *psys_ipdata,
+			     u8 hw_ver)
 {
-	isys_ipdata->csi2.nports = ARRAY_SIZE(ipu7_csi_offsets);
+	isys_ipdata->csi2.nports = is_ipu7(hw_ver) ? 4 : 3;
 	isys_ipdata->csi2.offsets = ipu7_csi_offsets;
 	isys_ipdata->num_parallel_streams = IPU7_ISYS_NUM_STREAMS;
 	psys_ipdata->hw_variant.spc_offset = IPU7_PSYS_SPC_OFFSET;
 }
@@ -2533,7 +2534,7 @@ static int ipu7_pci_probe(struct pci_dev *pdev, const struct pci_device_id *id)
 		return -ENODEV;
 	}

-	ipu_internal_pdata_init(isys_ipdata, psys_ipdata);
+	ipu_internal_pdata_init(isys_ipdata, psys_ipdata, isp->hw_ver);

 	isys_base = isp->base + isys_ipdata->hw_variant.offset;
 	psys_base = isp->base + psys_ipdata->hw_variant.offset;
diff --git a/drivers/staging/media/ipu7/ipu7.h b/drivers/staging/media/ipu7/ipu7.h
--- a/drivers/staging/media/ipu7/ipu7.h
+++ b/drivers/staging/media/ipu7/ipu7.h
@@ -243,6 +243,7 @@ struct ipu7_psys_pdata {
 int request_cpd_fw(const struct firmware **firmware_p, const char *name,
 		   struct device *device);
 void ipu_internal_pdata_init(struct ipu_isys_internal_pdata *isys_ipdata,
-			     struct ipu_psys_internal_pdata *psys_ipdata);
+			     struct ipu_psys_internal_pdata *psys_ipdata,
+			     u8 hw_ver);
 void ipu7_dump_fw_error_log(const struct ipu7_bus_device *adev);
 #endif /* IPU7_H */
--
